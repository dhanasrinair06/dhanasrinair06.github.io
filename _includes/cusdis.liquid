<div class="cusdis-comments" style="max-width: {{ site.max_width }}; margin: 2.5rem auto 0;">
  <h3>Was this helpful?</h3>
  <p style="font-size: 0.9rem; opacity: 0.8; margin-bottom: 1rem;">
    I'd love to know if this was useful — or any thoughts you have. Just add a nickname; no account needed.
  </p>
  <div
    id="cusdis_thread"
    data-host="https://cusdis.com"
    data-app-id="{{ site.cusdis.app_id }}"
    data-page-id="{{ page.url }}"
    data-page-url="{{ page.url | absolute_url }}"
    data-page-title="{{ page.title | escape }}"
  ></div>
</div>
<script async defer src="https://cusdis.com/js/cusdis.es.js"></script>
