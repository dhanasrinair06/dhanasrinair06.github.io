<div class="cusdis-comments" style="max-width: {{ site.max_width }}; margin: 2.5rem auto 0;">
  <p style="font-size: 0.9rem; opacity: 0.85; margin-bottom: 1rem;">
    Just drop a nickname and your comment below — no account required.
  </p>
  <div
    id="cusdis_thread"
    data-host="https://cusdis.com"
    data-app-id="{{ site.cusdis.app_id }}"
    data-page-id="{{ page.url }}"
    data-page-url="{{ page.url | absolute_url }}"
    data-page-title="{{ page.title | escape }}"
    data-theme="auto"
  ></div>
</div>
<script>
  // Match the Cusdis widget to the site's current light/dark theme so it blends in.
  (function () {
    function siteTheme() {
      var t = document.documentElement.getAttribute("data-theme");
      if (t === "dark" || t === "light") return t;
      return window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches
        ? "dark"
        : "light";
    }
    var el = document.getElementById("cusdis_thread");
    if (el) el.setAttribute("data-theme", siteTheme());
  })();
</script>
<script async defer src="https://cusdis.com/js/cusdis.es.js"></script>
